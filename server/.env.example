# Copy to .env for local runs. On Fly, set these with `fly secrets set`.
# The app sends this as its bearer token. Generate with: openssl rand -hex 32
APP_TOKEN=
# Encrypts the stored ESPN cookies and Yahoo tokens. Generate with: openssl rand -hex 32
STATE_KEY=
DATA_PATH=data/state.bin
PORT=8787

# Yahoo: create an app at https://developer.yahoo.com/apps/create/ with Fantasy Sports (Read) access.
# The redirect URI must be this server's https address plus /v1/yahoo/callback.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://huddle-api.fly.dev/v1/yahoo/callback

# Live Activity pushes (optional). Without these the Live Activity only changes while the app is open.
# Make a key at developer.apple.com > Keys with "Apple Push Notifications service (APNs)" checked. One key works
# for every app on the team. APNS_KEY_PATH is relative to server/ unless absolute; or put the key itself in
# APNS_KEY with \n for line breaks. APNS_ENV is development for builds installed from Xcode, production for TestFlight.
APNS_KEY_ID=
APNS_TEAM_ID=L67J56VPBG
APNS_KEY_PATH=
APNS_BUNDLE_ID=com.krogerjt.huddle
APNS_ENV=development
